{
  "name": "arnold",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "A Telegram bot that tracks what you eat, drink, smoke and train - by chatting with it. Runs on Vercel + Supabase.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "check": "node scripts/check.mjs",
    "webhook": "node scripts/webhook.mjs",
    "live": "ARNOLD_LIVE=1 vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
