# ---------------------------------------------------------------------------
# Arnold - environment variables
#
# Copy this file to .env.local for local development. On Vercel, add the same
# keys under Project Settings -> Environment Variables.
#
# Everything marked REQUIRED must be set or Arnold refuses to start and tells
# you which one is missing. Nothing here has a silent default.
# ---------------------------------------------------------------------------

# REQUIRED - Telegram bot token from @BotFather (looks like 12345:AAH...)
TELEGRAM_BOT_TOKEN=

# REQUIRED - a random string you invent. Telegram sends it back with every
# webhook call so nobody else can post fake updates to your endpoint.
# Generate one: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# REQUIRED after the first message - comma separated numeric chat IDs that are
# allowed to write to your database. Leave empty on first deploy: Arnold will
# reply to any message with the chat ID it saw, so you can paste it in here.
# An open bot means strangers writing into your health data.
TELEGRAM_ALLOWED_CHAT_IDS=

# REQUIRED - Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=

# REQUIRED - Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# REQUIRED - Supabase service role key (Project Settings -> API -> service_role).
# Server side only. Never expose it to a browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Voice messages. Without one of these, Arnold politely says it cannot hear
# voice notes and asks for text instead. Pick one provider.
#   openai -> OPENAI_API_KEY, groq -> GROQ_API_KEY
STT_PROVIDER=none
OPENAI_API_KEY=
GROQ_API_KEY=

# Model overrides. Defaults are in arnold.config.ts.
# ARNOLD_MODEL=claude-sonnet-5
# ARNOLD_COACH_MODEL=claude-opus-5

# Protects the weekly report endpoint. Generate one like the webhook secret.
# Vercel sends it as an Authorization header on its own cron calls once the
# variable exists. Without it, only Vercel cron can trigger the report and you
# cannot trigger it by hand.
CRON_SECRET=
